# ───────────── Fournisseur LLM (API compatible OpenAI) ─────────────
# Choisis UNE des configurations ci-dessous et copie-la dans .env

# 1) Groq (gratuit, rapide, supporte les outils) -> https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# 2) OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# 3) Anthropic (endpoint compatible OpenAI)
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# 4) Ollama en local (100% gratuit, hors-ligne) -> ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ───────────── Options ─────────────
LLM_TEMPERATURE=0.3
AGENT_MAX_STEPS=8

# Génération d'images : "pollinations" (gratuit, sans clé) ou "openai" (DALL·E, nécessite OPENAI_API_KEY)
IMAGE_PROVIDER=pollinations
# OPENAI_API_KEY=sk-...
